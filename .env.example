# Futuro backend Supabase. A aplicação funciona sem estas variáveis usando mocks.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima

# Token privado da Travelpayouts para consultar a Aviasales Flight Data API.
# Configure apenas no servidor/Vercel. Nunca use NEXT_PUBLIC_ neste token.
TRAVELPAYOUTS_API_TOKEN=seu-token-travelpayouts
