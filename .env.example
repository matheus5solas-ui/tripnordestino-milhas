# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publicavel
# Somente servidor. Nunca use NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Token privado da Travelpayouts. Somente servidor/Vercel.
TRAVELPAYOUTS_API_TOKEN=seu-token-travelpayouts

# SearchAPI.io para o radar de preços do Google Flights Deals.
# Somente servidor/Vercel. Nunca use NEXT_PUBLIC_.
SEARCHAPI_API_KEY=sua-chave-searchapi

# WhatsApp Cloud API (Meta). Todos somente servidor/Vercel.
WHATSAPP_ACCESS_TOKEN=seu-token-whatsapp
WHATSAPP_PHONE_NUMBER_ID=seu-phone-number-id
ALERT_ADMIN_WHATSAPP=55DDDNUMERO
# Opcional: fixe a versão Graph API homologada pelo projeto.
WHATSAPP_GRAPH_VERSION=v23.0
